{
  "name": "engineering-board",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "description": "Internal engineering workboard. Zero runtime dependencies: Node.js 22.16+ only.",
  "engines": {
    "node": ">=22.16"
  },
  "scripts": {
    "dev": "tsx watch --disable-warning=ExperimentalWarning server/src/index.ts",
    "start": "tsx --disable-warning=ExperimentalWarning server/src/index.ts",
    "test": "tsx --disable-warning=ExperimentalWarning --test --test-reporter=spec \"server/test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json && tsc -p web/tsconfig.json",
    "seed:demo": "tsx --disable-warning=ExperimentalWarning server/src/db/seedDemoCli.ts",
    "build": "node scripts/build.mjs",
    "dev:web": "node scripts/build.mjs --watch --web-only",
    "e2e": "node --test --test-concurrency=1 e2e/board.e2e.mjs"
  }
}