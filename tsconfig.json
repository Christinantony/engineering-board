{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@board/shared": [
        "./shared/src/index.ts"
      ]
    }
  },
  "include": [
    "shared/src",
    "server/src",
    "server/test"
  ]
}